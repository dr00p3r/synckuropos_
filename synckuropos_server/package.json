{
  "name": "synckuropos_server",
  "version": "1.0.0",
  "description": "Servidor backend de synckuropos con PostgreSQL + Drizzle ORM",
  "keywords": [
    "Server",
    "PostgreSQL",
    "Drizzle",
    "Sync"
  ],
  "license": "ISC",
  "author": "dr00p3r",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/synckuropos_server/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "jest --coverage",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.2",
    "express": "^5.1.0",
    "jest": "^30.2.0",
    "pg": "^8.20.0",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
