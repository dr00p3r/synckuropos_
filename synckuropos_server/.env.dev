# ============================================
# synckuropos_server — Variables de entorno LOCAL
# ============================================

# Puerto del servidor Express
PORT=3000

# Base de datos PostgreSQL local
# Asegúrate de crear la DB primero:
#   createdb synckuropos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synckuropos

# CORS — orígenes permitidos (el frontend Vite corre en 5173)
CORS_ORIGIN=http://localhost:5173

# Entorno
NODE_ENV=development

# JWT (si se implementa auth por token en el futuro)
JWT_SECRET=dev_secret_key_change_in_production
